{
  "version": "1.0.0",
  "paths": {
    "memory_root": "auto",
    "shared_root": "auto",
    "backup_dir": ".backups",
    "archive_dir": ".archive",
    "lock_dir": ".locks",
    "log_dir": ".logs"
  },
  "limits": {
    "max_memories_per_agent": 10000,
    "max_backups": 10,
    "max_memory_age_days": 365,
    "hot_tier_days": 30,
    "warm_tier_days": 180,
    "cold_tier_days": 365,
    "id_overflow_limit": 999
  },
  "compression": {
    "similarity_threshold": 0.7,
    "min_importance_score": 0.3,
    "target_count": null,
    "auto_compress_threshold": 5000
  },
  "security": {
    "sensitive_patterns": [
      "password",
      "密码",
      "secret",
      "密钥",
      "token",
      "令牌",
      "api_key",
      "apikey",
      "private_key",
      "私钥",
      "credential",
      "凭据",
      "auth",
      "认证"
    ],
    "warn_on_sensitive": true,
    "block_sensitive": false
  },
  "logging": {
    "level": "INFO",
    "max_log_size_mb": 2,
    "max_log_files": 2,
    "log_format": "%(asctime)s [%(levelname)s] %(message)s"
  },
  "database": {
    "version": 1,
    "auto_vacuum": true,
    "wal_mode": true,
    "cache_size": 1000
  },
  "sync": {
    "conflict_strategy": "newer_wins",
    "retry_count": 3,
    "retry_delay_seconds": 1,
    "lock_timeout_seconds": 30
  },
  "agent_detection": {
    "hermes": {
      "candidate_paths": [
        "~/.hermes/memories",
        "~/AppData/Local/hermes/memories",
        "~/AppData/Roaming/hermes/memories"
      ],
      "signature_file": "MEMORY.md",
      "signature_content": "§"
    },
    "claude": {
      "candidate_paths": [
        "~/.claude/projects"
      ],
      "signature_glob": "*/memory/MEMORY.md"
    },
    "trae": {
      "candidate_paths": [
        "~/.trae-cn/memory",
        "~/AppData/Roaming/Trae/memory"
      ],
      "signature_file": "user_profile.md"
    },
    "cursor": {
      "candidate_paths": [
        "~/.cursor/memory",
        "~/AppData/Roaming/Cursor/User/globalStorage/memory"
      ],
      "signature_glob": "**/*.md"
    },
    "windsurf": {
      "candidate_paths": [
        "~/.codeium/windsurf/memory",
        "~/AppData/Roaming/Windsurf/User/globalStorage/memory"
      ],
      "signature_glob": "**/*.md"
    },
    "cline": {
      "candidate_paths": [
        "~/.cline",
        "~/Documents/Cline",
        "~/AppData/Roaming/Claude/memory"
      ],
      "signature_glob": "**/*.md",
      "memory_bank_pattern": "memory-bank/*.md",
      "note": "Cline；项目级 .clinerules/ + 全局 ~/Documents/Cline/Rules/；Memory Bank 最佳实践 memory-bank/*.md"
    },
    "continue": {
      "candidate_paths": [
        "~/.continue/memory",
        "~/AppData/Roaming/Continue/memory"
      ],
      "signature_glob": "**/*.md"
    },
    "aider": {
      "candidate_paths": [
        "~/.aider.memory",
        "~/.aider"
      ],
      "signature_file": ".aider.memory.md"
    },
    "roo-code": {
      "candidate_paths": [
        "~/.roo-code/memory",
        "~/AppData/Roaming/Roo-Code/memory"
      ],
      "signature_glob": "**/*.md"
    },
    "codex": {
      "candidate_paths": [
        "~/.codex"
      ],
      "signature_file": "config.toml",
      "memory_file": "AGENTS.md",
      "note": "OpenAI Codex CLI 2026；全局 AGENTS.md 在 ~/.codex/，项目级 AGENTS.md 向上查找；会话历史在 sessions/"
    },
    "codepilot": {
      "candidate_paths": [
        "~/.codepilot"
      ],
      "signature_file": "codepilot.db",
      "storage_type": "sqlite"
    },
    "codebuddy": {
      "candidate_paths": [
        "~/.codebuddy",
        "~/.codebuddy/memory",
        "~/.codebuddy/memery",
        "~/AppData/Roaming/CodeBuddy"
      ],
      "signature_file": "settings.json",
      "signature_glob": "*_mem*.md",
      "note": "CodeBuddy CLI 根目录只有配置；记忆文件在 ~/.codebuddy/memery/*_memery.md（CodeBuddy 自身拼写错误，glob 用 *_mem*.md 容错）或同步到 codepilot/openclaw"
    },
    "workbuddy": {
      "candidate_paths": [
        "~/.workbuddy",
        "~/AppData/Roaming/WorkBuddy"
      ],
      "signature_file": "MEMORY.md",
      "additional_memory_files": [
        "SOUL.md",
        "IDENTITY.md",
        "USER.md",
        "BOOTSTRAP.md"
      ],
      "sqlite_db": "workbuddy.db",
      "note": "WorkBuddy IDE；MEMORY.md 等为模板文件，实际记忆在 workbuddy.db + sessions/*.json + audit-log/*.jsonl"
    },
    "qwen": {
      "candidate_paths": [
        "~/.qwen"
      ],
      "signature_file": "settings.json",
      "memory_glob": "projects/*/chats/*.jsonl",
      "note": "Qwen Code CLI；会话历史在 projects/*/chats/*.jsonl，todos/*.json"
    },
    "qoder": {
      "candidate_paths": [
        "~/.qoder"
      ],
      "signature_file": "MEMORY.md",
      "note": "Qoder IDE；MEMORY.md 可异常膨胀，需流式或截断读取"
    },
    "qwenpaw": {
      "candidate_paths": [
        "~/.qwenpaw"
      ],
      "signature_file": "HEARTBEAT.md",
      "note": "QwenPaw 自主 Agent；HEARTBEAT.md 为心跳清单"
    },
    "gemini-cli": {
      "candidate_paths": [
        "~/.gemini"
      ],
      "signature_file": "settings.json",
      "memory_file": "GEMINI.md",
      "memory_section_header": "## Gemini Added Memories",
      "memory_creation_command": "/memory",
      "note": "Gemini CLI；GEMINI.md 需用户通过 /memory 或 save_memory 工具主动创建，默认不存在"
    },
    "opencode": {
      "candidate_paths": [
        "~/.config/opencode"
      ],
      "signature_file": "agents.md",
      "note": "OpenCode；全局 agents.md 在 ~/.config/opencode/，项目级 AGENTS.md 在项目根目录"
    },
    "alphaclaw": {
      "candidate_paths": [
        "~/.config/alphaclaw"
      ],
      "signature_glob": "*.db",
      "storage_type": "sqlite_config_only",
      "note": "AlphaClaw；3 个 .db 全为配置/凭据/技能状态存储（connector-config.db + pending-tool-results.db + skill-preferences.db），实测全为空表，不存储记忆内容；保留检测但跳过导出"
    },
    "copilot": {
      "candidate_paths": [
        "~/.config/github-copilot",
        "~/AppData/Local/GitHub Copilot"
      ],
      "signature_glob": "**/*.md",
      "note": "GitHub Copilot 以项目级 .github/copilot-instructions.md 为主，全局记忆有限"
    },
    "openclaw": {
      "candidate_paths": [
        "~/.openclaw",
        "~/AppData/Roaming/openclaw"
      ],
      "signature_glob": "**/*.md"
    },
    "pi": {
      "candidate_paths": [
        "~/.pi"
      ],
      "signature_file": "MEMORY.md",
      "additional_signature_paths": [
        "~/.pi/agent/settings.json"
      ],
      "note": "Pi Agent；signature 用根目录 MEMORY.md（~/.pi/settings.json 不存在）；记忆在 MEMORY.md + memory/MEMORY.md + agent/sessions/*.jsonl；agent/auth.json 含明文 API Key 需排除"
    },
    "dsh": {
      "candidate_paths": [
        "~/.dsh",
        "~/AppData/Roaming/dsh",
        "~/AppData/Local/dsh"
      ],
      "signature_file": "settings.yaml",
      "signature_paths_fallback": [
        "~/.dsh/.anonymous-user-id"
      ],
      "note": "DeepSeek DSH CLI（dsh-code）；根目录 settings.yaml 为签名；会话在 sessions/*/session.jsonl(.zstd)，工作区状态在 storages/*.json；.credentials.yaml 含凭据必须排除"
    }
  },
  "agents_md_standard": {
    "enabled": true,
    "project_level_file": "AGENTS.md",
    "global_path": "~/.agents/AGENTS.md",
    "supported_agents": [
      "codex",
      "opencode",
      "cline",
      "claude",
      "gemini-cli",
      "roo-code"
    ],
    "note": "AGENTS.md 是 2026 年跨工具标准；AgentMemorySystem 可读取项目级 AGENTS.md 作为记忆源"
  },
  "agent_overrides": {},
  "sync_tool": {
    "auto_interval_days": 7,
    "conflict_action": "prompt",
    "cache_ttl_hours": 24
  }
}